<?xml version="1.0" encoding="UTF-8"?>
<archetype-descriptor
    xmlns="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0
    https://maven.apache.org/xsd/archetype-descriptor-1.1.0.xsd"
    name="java-service-archetype">

  <!--
    All module creation is handled by archetype-post-generate.groovy.
    These required properties drive what the script generates.

    PROMPT GUIDE
    ============
    integrations
      Comma-separated list of  type:name  pairs.
      Supported types: database, rest, graphql, file, email, jms, kafka, ...
      The "database" type is abbreviated to "db" in module/package names.
      Example: database:users,rest:orders,graphql:catalog

    serviceAreas
      Leave blank for a single module named "service".
      Enter comma-separated names to generate multiple service areas:
        each name produces a "service-{name}" module.
      Example: orders,inventory,notifications

    presentationTypes
      Comma-separated list of API / presentation-tier types.
      Supported types: rest, graphql, soap, grpc, ...
      Example: rest,graphql
  -->

  <requiredProperties>

    <requiredProperty key="version">
      <defaultValue>1.0.0-SNAPSHOT</defaultValue>
    </requiredProperty>

    <requiredProperty key="integrations">
      <!-- No default: at least one integration is expected.
           Format: type:name[,type:name,...]
           Example: database:main,rest:payments -->
    </requiredProperty>

    <requiredProperty key="serviceAreas">
      <!-- The archetype plugin treats an empty value as "not configured" and aborts
           ("Property serviceAreas is missing") before archetype-post-generate.groovy runs,
           so the default is the "," sentinel rather than blank. The script maps ","
           (which String.split yields as an empty list) to a single module named "service".
           Override with comma-separated names for multiple areas, e.g. orders,inventory. -->
      <defaultValue>,</defaultValue>
    </requiredProperty>

    <requiredProperty key="presentationTypes">
      <defaultValue>rest</defaultValue>
      <!-- Comma-separated types, e.g. rest,graphql -->
    </requiredProperty>

    <requiredProperty key="includeSpring">
      <defaultValue>true</defaultValue>
      <!-- true (default): generate the Spring Boot wiring — parent inherits
           spring-boot-starter-parent, every app-composed module gets a @Configuration
           class and spring-context, and app gets the Application / AppServletInitializer
           classes plus the web and data-jpa starters.
           false: omit all Spring artifacts (configs, classes, and pom items). -->
    </requiredProperty>

  </requiredProperties>

  <!--
    No static fileSets or module declarations here.
    The post-generate Groovy script constructs the entire module tree.
  -->

</archetype-descriptor>
